{
  "name": "lsmp-lua-vscode",
  "displayName": "LS:MP Lua",
  "description": "IntelliSense for LS:MP",
  "version": "0.1.0",
  "publisher": "space",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spacevx/lsmp-lua-vscode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "Lua",
    "LS:MP",
    "LSMP",
    "GTA V",
    "IntelliSense"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/manifest.json",
    "onLanguage:lua"
  ],
  "extensionDependencies": [
    "sumneko.lua"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lsmp.enable",
        "title": "Enable for this workspace",
        "category": "LS:MP"
      },
      {
        "command": "lsmp.disable",
        "title": "Disable for this workspace",
        "category": "LS:MP"
      },
      {
        "command": "lsmp.updateDefinitions",
        "title": "Update definitions from lsmp.gg",
        "category": "LS:MP"
      },
      {
        "command": "lsmp.searchApi",
        "title": "Search the API documentation",
        "category": "LS:MP"
      },
      {
        "command": "lsmp.openDocs",
        "title": "Open the SDK reference",
        "category": "LS:MP"
      },
      {
        "command": "lsmp.server.start",
        "title": "Start server",
        "category": "LS:MP",
        "icon": "$(debug-start)"
      },
      {
        "command": "lsmp.server.restart",
        "title": "Restart server",
        "category": "LS:MP",
        "icon": "$(debug-restart)"
      },
      {
        "command": "lsmp.server.stop",
        "title": "Stop server",
        "category": "LS:MP",
        "icon": "$(debug-stop)"
      },
      {
        "command": "lsmp.server.metrics",
        "title": "Show server metrics",
        "category": "LS:MP",
        "icon": "$(pulse)"
      }
    ],
    "configuration": {
      "title": "LS:MP Lua",
      "properties": {
        "lsmp.enable": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "markdownDescription": "`auto`: when a `manifest.json` lists scripts. `always` / `never` force it."
        },
        "lsmp.natives": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Include GTA V natives."
        },
        "lsmp.autoUpdate": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Update definitions from lsmp.gg automatically."
        },
        "lsmp.updateIntervalHours": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "markdownDescription": "Hours between checks. `0`: only when a workspace opens."
        },
        "lsmp.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `lsmp-server.exe`. Empty: auto-detect."
        },
        "lsmp.eventTypes": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Type event handler parameters from what their emitters send."
        }
      }
    },
    "snippets": [
      {
        "language": "lua",
        "path": "./snippets/lua.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "**/resources/*/manifest.json",
          "**/resources/**/manifest.json",
          "**/LSMP/resources/*/manifest.json"
        ],
        "url": "./schemas/manifest.schema.json"
      },
      {
        "fileMatch": [
          "**/resources.json"
        ],
        "url": "./schemas/resources.schema.json"
      }
    ],
    "keybindings": [
      {
        "command": "lsmp.server.restart",
        "key": "ctrl+alt+r",
        "when": "lsmp.serverRunning"
      },
      {
        "command": "lsmp.server.start",
        "key": "ctrl+alt+r",
        "when": "!lsmp.serverRunning"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "fetch": "npm run build && node dist/cli.js fetch",
    "generate": "npm run build && node dist/cli.js generate",
    "typecheck": "tsc -p . --noEmit",
    "vscode:prepublish": "npm run build && node dist/cli.js fetch && node dist/cli.js generate",
    "package": "vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.80.0",
    "@vscode/vsce": "3.6.0",
    "typescript": "5.9.3"
  }
}
